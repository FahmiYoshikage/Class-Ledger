# Server Environment Variables - PRODUCTION
# Copy this file to .env.production at: /opt/telkom-cup/server/.env

# Server Configuration
PORT=5000
NODE_ENV=production

# MongoDB Configuration - MongoDB Atlas
# Ganti URI ini dengan Atlas cluster Anda
MONGODB_URI=mongodb+srv://user:password@cluster.mongodb.net/kas-kelas

# WhatsApp Configuration (Fonnte)
# FONNTE_API_TOKEN=nfbJg3AToThMuurynxg8
FONNTE_API_TOKEN=your-fonnte-token-here
WA_TEST_MODE=false
AUTO_REMINDER_ENABLED=true
FONNTE_GROUP_ID=120363402325545063@g.us

# 🛡️ Anti-Ban Protection Settings
# Maksimal pesan per hari & per jam
WA_MAX_PER_DAY=30
WA_MAX_PER_HOUR=8
# Delay antar pesan (ms): 45 detik - 3 menit
WA_DELAY_MIN=45000
WA_DELAY_MAX=180000
# Batch: setiap 4 pesan, istirahat 5-10 menit
WA_BATCH_SIZE=4
WA_BATCH_PAUSE_MIN=300000
WA_BATCH_PAUSE_MAX=600000
# Jitter cron: random 0-25 menit dari jadwal
WA_CRON_JITTER=25

# Application Start Date (for week calculation)
START_DATE=2025-11-03

# JWT Secret - PRODUCTION (KEEP SECRET!)
# Ganti dengan secret key kuat minimal 32 karakter
JWT_SECRET=change-this-secret-key-minimum-32-chars

# CORS Origin - Production Domain
CORS_ORIGIN=https://triforce.crud.my.id

# Base URL for PDF links (used in WhatsApp broadcasts)
BASE_URL=https://triforce.crud.my.id