# ==============================================================================
# CLASS-LEDGER: TURNKEY ENVIRONMENT CONFIGURATION
# ==============================================================================
# Salin file ini menjadi `.env` lalu sesuaikan dengan lingkungan server Anda:
#   cp .env.example .env
#
# Catatan: Konfigurasi nama kelas, nominal kas mingguan, rekening pembayaran,
# dan kredensial bendahara dapat diatur langsung melalui Web Setup Wizard (/setup)
# pada instalasi pertama kali tanpa perlu mengedit file ini.
# ==============================================================================

# 🌐 Server & Network
PORT=5000
NODE_ENV=production
BASE_URL=http://localhost:5000
CORS_ORIGIN=http://localhost:5000,http://localhost:5173

# 🗄️ Database MongoDB
# Jika menggunakan Docker Compose bawaan, gunakan: mongodb://mongo:27017/kas-kelas
# Jika menggunakan MongoDB lokal: mongodb://127.0.0.1:27017/kas-kelas
# Jika menggunakan MongoDB Atlas: mongodb+srv://<user>:<password>@cluster.mongodb.net/kas-kelas
MONGODB_URI=mongodb://127.0.0.1:27017/kas-kelas

# 🔐 Keamanan & Autentikasi (JWT)
# Ganti JWT_SECRET dengan string acak yang aman dan rahasia!
JWT_SECRET=ganti-dengan-kunci-rahasia-yang-sangat-aman-dan-panjang-min-32-karakter
JWT_EXPIRES_IN=7d

# ==============================================================================
# 🤖 WhatsApp Gateway (Fonnte) - OPSIONAL (Bisa diisi via UI Pengaturan)
# ==============================================================================
# Dapatkan API token gratis dari https://fonnte.com
FONNTE_API_TOKEN=
FONNTE_GROUP_ID=

# Mode Pengujian WhatsApp (true = log ke console saja tanpa kirim pesan nyata)
WA_TEST_MODE=false

# Auto-reminder harian otomatis ke siswa yang memiliki tunggakan
AUTO_REMINDER_ENABLED=true
WA_DAILY_REMINDER_CRON="0 10 * * *"
WA_GROUP_BROADCAST_CRON="0 18 * * 0"

# 🛡️ Fitur Human-like Anti-Ban WhatsApp Bot
WA_MAX_PER_DAY=30
WA_MAX_PER_HOUR=15
WA_DELAY_MIN=45000
WA_DELAY_MAX=180000
WA_BATCH_SIZE=4
WA_BATCH_PAUSE_MIN=300000
WA_BATCH_PAUSE_MAX=600000
WA_CRON_JITTER=25
